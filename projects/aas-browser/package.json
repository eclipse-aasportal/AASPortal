{
    "name": "aas-browser",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "ng": "ng",
        "serve": "ng serve aas-browser --host=127.0.0.1",
        "build": "rimraf ./dist && ng build",
        "build:debug": "rimraf ./dist && ng build --configuration development",
        "tsc": "rimraf build && tsc -p tsconfig.json",
        "watch": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.ts --no-cache --coverage=false --watch",
        "test": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.ts --no-cache",
        "lint": "ng lint aas-browser",
        "format": "ng lint aas-browser --fix"
    },
    "private": true
}