{
    "name": "aas-browser",
    "version": "3.6",
    "type": "module",
    "scripts": {
        "ng": "ng",
        "serve": "ng serve aas-browser --host=127.0.0.1",
        "build": "rimraf ./dist && ng build aas-browser",
        "build:debug": "rimraf ./dist && ng build aas-browser --configuration development",
        "tsc": "rimraf build && tsc -p tsconfig.json",
        "watch": "ng test aas-browser --coverage=false",
        "test": "ng test aas-browser --no-watch",
        "lint": "ng lint aas-browser",
        "format": "ng lint aas-browser --fix"
    },
    "private": true
}