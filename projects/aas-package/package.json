{
    "name": "aas-package",
    "version": "3.2.0",
    "description": "AASX package library.",
    "module": "./dist/aas-package.js",
    "main": "./dist/aas-package.js",
    "typings": "./dist/types/index.d.ts",
    "author": "IOSB-INA Fraunhofer",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "test": "rimraf src/test/assets/tmp && node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.ts",
        "coverage": "node coverage-summary.js",
        "build": "rimraf dist && tsc -p tsconfig.lib.json && node esbuild.prod.js",
        "build:debug": "rimraf dist && tsc -p tsconfig.lib.json && node esbuild.dev.js",
        "tsc": "rimraf build && tsc -p tsconfig.json",
        "lint": "eslint src/lib/**/*.ts",
        "format": "eslint src/lib/**/*.ts --fix",
        "watch": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.ts --watch --coverage=false"
    },
    "dependencies": {
        "@aas-core-works/aas-core3.0-typescript": "^1.0.3",
        "@xmldom/xmldom": "^0.8.10",
        "jszip": "^3.10.1",
        "lodash-es": "^4.17.21",
        "reflect-metadata": "^0.2.2",
        "tslib": "^2.8.1",
        "tsyringe": "^4.10.0",
        "uuid": "^13.0.0",
        "xpath": "^0.0.34"
    }
}
