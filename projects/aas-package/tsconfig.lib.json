{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist/lib",
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "./dist/types",
        "noEmit": false,
        "rootDir": "./src/lib"
    },
    "include": [
        "./src/lib/**/*.ts"
    ],
    "exclude": [
        "./src/lib/**/*.spec.ts"
    ]
}