{
    "name": "aas-node",
    "version": "3.0.0",
    "author": "Fraunhofer IOSB-INA",
    "license": "Apache 2.0",
    "description": "Web-based visualization and control of asset administration shells.",
    "module": "./dist/aas-node.js",
    "homepage": "https://www.iosb-ina.fraunhofer.de/",
    "type": "module",
    "scripts": {
        "tsoa": "tsoa spec-and-routes -c tsoa.config.json",
        "serve": "rimraf build && npm run tsoa && tsc -p tsconfig.app.json",
        "test": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.ts",
        "test:debug": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.js --runInBand --no-cache --verbose --watchAll=true",
        "build": "rimraf dist && npm run tsoa && node esbuild.prod.js",
        "build:debug": "rimraf dist && npm run tsoa && node esbuild.dev.js",
        "tsc": "rimraf build && tsc -p tsconfig.json",
        "lint": "eslint src/app/**/*.ts",
        "format": "eslint src/app/**/*.ts --fix",
        "watch": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js -c jest.config.js --watch"
    },
    "dependencies": {
        "@babel/polyfill": "^7.12.1",
        "@xmldom/xmldom": "^0.8.10",
        "axios": "^1.8.4",
        "bcryptjs": "^3.0.2",
        "chalk": "^2.4.1",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "form-data": "^4.0.2",
        "jimp": "^1.6.0",
        "jsonwebtoken": "^9.0.2",
        "jszip": "^3.10.1",
        "lodash-es": "^4.17.21",
        "lowdb": "^7.0.1",
        "mongoose": "^8.13.1",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.2",
        "mysql2": "^3.14.0",
        "node-opcua": "^2.139.0",
        "node-opcua-client-crawler": "^2.127.1",
        "nodemailer": "^6.10.0",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "tslib": "^2.8.1",
        "tsoa": "^6.6.0",
        "tsyringe": "^4.8.0",
        "uuid": "^11.1.0",
        "webdav": "^5.8.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "ws": "^8.18.1",
        "xpath": "^0.0.34"
    }
}