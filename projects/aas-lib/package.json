{
    "name": "aas-lib",
    "version": "3.9",
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "ng": "ng",
        "test": "ng test aas-lib --no-watch",
        "test:unit": "ng test aas-browser --no-watch --coverage=false",
        "watch": "ng test aas-lib --coverage=false",
        "build": "ng build aas-lib",
        "build:debug": "ng build aas-lib --configuration development",
        "tsc": "rimraf build && tsc -p tsconfig.json",
        "lint": "ng lint aas-lib",
        "format": "ng lint aas-lib --fix",
        "docs": "typedoc --out docs"
    }
}