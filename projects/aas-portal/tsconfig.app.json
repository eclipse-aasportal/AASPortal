{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "noEmit": false,
        "outDir": "./out-tsc/app",
        "types": ["@angular/localize"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/test/**/*", "src/app/**/*.spec.ts"],
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "nullishCoalescingNotNullable": "suppress",
                "optionalChainNotNullable": "suppress"
            }
        }
    }
}
