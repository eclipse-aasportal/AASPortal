{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compileOnSave": false,
    "compilerOptions": {
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "isolatedModules": true,
        "module": "es2022",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2024",
        "useUnknownInCatchVariables": false
    },
    "lib": [
        "ES2024",
        "dom"
    ],
    "ts-node": {
        "esm": true
    },
    "references": [
        {
            "path": "./projects/aas-core/tsconfig.json"
        },
        {
            "path": "./projects/aas-package/tsconfig.json"
        },
        {
            "path": "./projects/aas-node/tsconfigjson"
        },
        {
            "path": "./projects/aas-server/tsconfig.json"
        },
        {
            "path": "./projects/aas-lib/tsconfig.json"
        },
        {
            "path": "./projects/aas-portal/tsconfig.json"
        },
        {
            "path": "./projects/aas-browser/tsconfig.json"
        }
    ]
}