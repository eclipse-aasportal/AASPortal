{
    "name": "aas-portal-project",
    "version": "3.2.0-development.11",
    "description": "Web-based visualization and control of asset administration shells.",
    "type": "module",
    "scripts": {
        "create-app-info": "node --no-warnings --loader ts-node/esm create-app-info.ts",
        "tsoa": "npm run tsoa -w=aas-node",
        "docker:build": "docker build -f Dockerfile -t aasportal . && docker run -d --name AASPortal -p 80:80 --restart=always aasportal",
        "podman:build": "podman build -f Dockerfile -t aasportal . && podman run -d --name AASPortal -p 80:80 --restart=always aasportal",
        "start:podman-aio": "podman run -p 80:80 docker.io/fraunhoferiosb/aasportal_aio",
        "header": "node --no-warnings --loader ts-node/esm copyright-header.ts",
        "coverage": "node --no-warnings --loader ts-node/esm coverage-summary.ts",
        "lint": "npm run lint --workspaces",
        "format": "npm run format --workspaces",
        "test": "npm run test --workspaces",
        "tsc": "npm run tsc --workspaces",
        "build": "npm run build --workspaces",
        "build:debug": "npm run build:debug --workspaces",
        "lib:build": "npm run build -w=aas-core -w=aas-lib",
        "lib:build:debug": "npm run build:debug -w=aas-core -w=aas-lib",
        "aas-portal:build": "npm run build -w=aas-core -w=aas-lib -w=aas-portal",
        "aas-portal:build:debug": "npm run build:debug -w=aas-core -w=aas-lib -w=aas-portal",
        "aas-node:build": "npm run build -w=aas-core -w=aas-node",
        "aas-node:build:debug": "npm run build:debug -w=aas-core -w=aas-node",
        "aas-server:build": "npm run build -w=aas-core -w=aas-lib -w=aas-server -w=aas-browser",
        "aas-server:build:debug": "npm run build:debug -w=aas-core -w=aas-lib -w=aas-server -w=aas-browser",
        "serve": "npm run build && node --env-file projects/aas-node/.env projects/aas-node/dist/aas-node.js",
        "test:docker": "docker build -f Dockerfile.test -t test --progress=plain . &> build.log",
        "test:podman": "podman build -f Dockerfile.test -t test --progress=plain . &> build.log",
        "docs": "rimraf ./docs && typedoc"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eclipse-aasportal/AASPortal.git"
    },
    "author": "Fraunhofer IOSB-INA",
    "homepage": "https://www.iosb-ina.fraunhofer.de/",
    "license": "Apache-2.0",
    "workspaces": [
        "projects/aas-jest",
        "projects/aas-core",
        "projects/aas-node",
        "projects/aas-lib",
        "projects/aas-portal",
        "projects/aas-server",
        "projects/aas-browser"
    ],
    "dependencies": {
        "@aas-core-works/aas-core3.0-typescript": "^1.0.3",
        "@angular/animations": "^20.3.0",
        "@angular/common": "^20.3.0",
        "@angular/compiler": "^20.3.0",
        "@angular/core": "^20.3.0",
        "@angular/forms": "^20.3.0",
        "@angular/localize": "^20.3.0",
        "@angular/platform-browser": "^20.3.0",
        "@angular/platform-browser-dynamic": "^20.3.0",
        "@angular/router": "^20.3.0",
        "@babel/polyfill": "^7.12.1",
        "@ng-bootstrap/ng-bootstrap": "^19.0.1",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "@popperjs/core": "^2.11.8",
        "@xmldom/xmldom": "^0.8.10",
        "axios": "^1.12.2",
        "bcryptjs": "^3.0.2",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "chart.js": "^4.5.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "form-data": "^4.0.4",
        "jimp": "^1.6.0",
        "jsonwebtoken": "^9.0.2",
        "jszip": "^3.10.1",
        "jwks-rsa": "^3.2.0",
        "jwt-decode": "^4.0.0",
        "lodash-es": "^4.17.21",
        "lowdb": "^7.0.1",
        "marked": "^16.3.0",
        "mongoose": "^8.18.1",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "mysql2": "^3.14.5",
        "node-opcua": "^2.156.0",
        "node-opcua-client-crawler": "^2.127.1",
        "nodemailer": "^7.0.6",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "~7.8.2",
        "swagger-ui-express": "^5.0.1",
        "tslib": "^2.8.1",
        "tsoa": "^6.6.0",
        "tsyringe": "^4.10.0",
        "uuid": "^13.0.0",
        "webdav": "^5.8.0",
        "ws": "^8.18.3",
        "xpath": "^0.0.34"
    },
    "devDependencies": {
        "@angular/build": "^20.3.1",
        "@angular/cli": "^20.3.1",
        "@angular/compiler-cli": "^20.3.0",
        "@babel/plugin-syntax-import-attributes": "^7.27.1",
        "@eslint/js": "^9.35.0",
        "@jest/globals": "^30.1.2",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^11.0.6",
        "@types/bcryptjs": "^3.0.0",
        "@types/bootstrap": "^5.2.10",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/jquery": "^3.5.33",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash-es": "^4.17.12",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.15.0",
        "@types/nodemailer": "^7.0.1",
        "@types/qrcode": "^1.5.5",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "aas-jest": "./projects/aas-jest",
        "angular-eslint": "20.3.0",
        "esbuild": "^0.25.9",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.4.0",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.1.2",
        "jest-junit": "^16.0.0",
        "jest-preset-angular": "^15.0.1",
        "ng-packagr": "^20.3.0",
        "prettier": "^3.6.2",
        "prettier-eslint": "^16.4.2",
        "rimraf": "^6.0.1",
        "semantic-release": "^24.2.8",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.2",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.13",
        "typescript": "^5.8.3",
        "typescript-eslint": "8.44.0"
    }
}
