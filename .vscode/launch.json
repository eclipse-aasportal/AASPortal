{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch aas-portal",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "start",
            "url": "http://localhost:4200/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch aas-node",
            "type": "node",
            "args": [],
            "request": "launch",
            "preLaunchTask": "build-aas-node",
            "program": "${workspaceFolder}/projects/aas-node/build/aas-node.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-node/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development",
                "AAS_NODE_PORT": "1337",
                "CONTENT_ROOT": "projects/aas-node/build",
                "WEB_ROOT": "projects/aas-portal/dist/browser",
                "ASSETS": "projects/aas-node/src/assets",
                "ENDPOINTS": "[\"http://localhost:50010/api/v3/?name=AAS%20Server\"]",
                "USER_STORAGE": "mongodb://aas-node:bObXJWW6e8Nh78YF@localhost:27017/aasportal-users",
                "TEMPLATE_STORAGE": "http://aas-node:5w0vmrkzrwDIDyZs@localhost:8080/templates",
                "AAS_INDEX": "mysql://aas-node:60PYRe6Vd8C99u4n@localhost:3306",
            }
        },
        {
            "name": "Launch aas-server",
            "type": "node",
            "args": [],
            "request": "launch",
            "preLaunchTask": "build-aas-server",
            "program": "${workspaceFolder}/projects/aas-server/build/aas-server.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-server/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development",
                "AAS_SERVER_PORT": "50010",
                "CONTENT_ROOT": "projects/aas-server/build",
                "WEB_ROOT": "projects/aas-browser/dist/browser",
                "ASSETS": "projects/aas-server/src/assets",
            }
        },
        {
            "name": "Launch aas-browser",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "launch-aas-browser",
            "url": "http://localhost:4200/"
        },
        {
            "name": "Test aas-node",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-node"
            ],
        },
        {
            "name": "Debug aas-node test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-node",
                "--testPathPattern",
                "${fileBasename}"
            ],
        },
        {
            "name": "Test aas-core",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-core"
            ]
        },
        {
            "name": "Debug aas-core test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-core",
                "--testPathPattern",
                "${fileBasename}"
            ]
        },
        {
            "name": "Debug current aas-lib test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-lib",
                "--testPathPattern",
                "${fileBasename}",
                "--coverage=false"
            ]
        },
        {
            "name": "Debug current aas-portal test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-portal",
                "--testPathPattern",
                "--coverage=false",
                "${fileBasename}"
            ]
        },
        {
            "name": "Debug current aas-browser test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-browser",
                "--testPathPatterns",
                "${fileBasename}"
            ]
        },
        {
            "name": "Debug current aas-server test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "test",
                "-w",
                "aas-server",
                "--testPathPatterns",
                "${fileBasename}"
            ]
        }
    ]
}